<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Club de los Panchos</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #fff8ec;
    color: #3b2417;
}

button {
    border: none;
    cursor: pointer;
    font-family: inherit;
}

.app {
    max-width: 480px;
    margin: auto;
    min-height: 100vh;
    background: #fff8ec;
}

/* ================= HEADER ================= */

.header {
    background: #4a2b1b;
    color: white;
    padding: 18px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 20;
}

.logo {
    font-weight: 900;
    font-size: 21px;
    line-height: 18px;
}

.logo span {
    color: #ffb52e;
}

.cart-icon {
    background: #ffb52e;
    color: #3b2417;
    border-radius: 50%;
    width: 42px;
    height: 42px;
    font-size: 19px;
    position: relative;
}

.cart-count {
    position: absolute;
    right: -3px;
    top: -4px;
    background: #e65325;
    color: white;
    border-radius: 50%;
    width: 19px;
    height: 19px;
    font-size: 11px;
    display: flex;
    justify-content: center;
    align-items: center;
}

/* ================= SCREENS ================= */

.screen {
    display: none;
    padding-bottom: 90px;
}

.screen.active {
    display: block;
}

.container {
    padding: 20px;
}

/* ================= HOME ================= */

.hero {
    background: #f29b27;
    margin: 18px;
    border-radius: 25px;
    padding: 30px 22px;
    color: #3b2417;
}

.hero h1 {
    font-size: 38px;
    line-height: 0.95;
    font-weight: 900;
    text-transform: uppercase;
}

.hero p {
    margin-top: 15px;
    font-size: 15px;
}

.fake-hotdog {
    font-size: 80px;
    text-align: center;
    margin: 15px 0;
}

.main-button {
    width: 100%;
    padding: 15px;
    border-radius: 13px;
    background: #4a2b1b;
    color: white;
    font-weight: bold;
    font-size: 15px;
    margin-top: 12px;
}

.secondary-button {
    width: 100%;
    padding: 15px;
    border-radius: 13px;
    background: white;
    color: #4a2b1b;
    font-weight: bold;
    font-size: 15px;
    margin-top: 10px;
    border: 2px solid #4a2b1b;
}

.section-title {
    font-size: 26px;
    font-weight: 900;
    margin-bottom: 15px;
}

.home-card {
    background: white;
    border-radius: 18px;
    padding: 20px;
    margin-bottom: 15px;
    box-shadow: 0 3px 10px rgba(59,36,23,.08);
}

.home-card h3 {
    font-size: 21px;
    margin-bottom: 7px;
}

.home-card p {
    color: #765f51;
    font-size: 14px;
}

/* ================= PRODUCTS ================= */

.product-card {
    background: white;
    border-radius: 20px;
    padding: 18px;
    margin-bottom: 15px;
    box-shadow: 0 3px 10px rgba(59,36,23,.08);
}

.product-image {
    background: #ffe0a3;
    border-radius: 16px;
    height: 130px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 70px;
    margin-bottom: 14px;
}

.product-card h3 {
    font-size: 21px;
}

.product-description {
    font-size: 13px;
    color: #765f51;
    margin: 5px 0 12px;
}

.product-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.price {
    font-weight: 900;
    font-size: 19px;
}

.add-button {
    background: #f29b27;
    padding: 11px 17px;
    border-radius: 11px;
    font-weight: bold;
}

/* ================= CART ================= */

.cart-item {
    background: white;
    padding: 16px;
    border-radius: 15px;
    margin-bottom: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.quantity {
    display: flex;
    align-items: center;
    gap: 10px;
}

.quantity button {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #f29b27;
    font-weight: bold;
}

.total-box {
    background: #4a2b1b;
    color: white;
    border-radius: 18px;
    padding: 20px;
    margin-top: 20px;
}

.total-row {
    display: flex;
    justify-content: space-between;
    font-size: 18px;
}

.total-row strong {
    font-size: 24px;
}

/* ================= CALENDAR ================= */

.calendar {
    background: white;
    border-radius: 20px;
    padding: 18px;
    box-shadow: 0 3px 10px rgba(59,36,23,.08);
}

.calendar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
}

.calendar-header button {
    background: #f29b27;
    border-radius: 9px;
    width: 35px;
    height: 35px;
}

.calendar-title {
    font-size: 18px;
    font-weight: 900;
}

.weekdays,
.days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 5px;
}

.weekdays div {
    text-align: center;
    font-size: 11px;
    font-weight: bold;
    color: #8b7465;
    padding-bottom: 8px;
}

.day {
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    font-weight: bold;
    font-size: 13px;
}

.day.available {
    background: #fff2d5;
    cursor: pointer;
}

.day.available:hover {
    background: #f29b27;
}

.day.occupied {
    background: #e5dcd6;
    color: #9b8d84;
    text-decoration: line-through;
}

.day.selected {
    background: #4a2b1b;
    color: white;
}

.legend {
    display: flex;
    gap: 15px;
    font-size: 11px;
    margin-top: 15px;
}

.legend span {
    display: flex;
    align-items: center;
    gap: 5px;
}

.dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
}

.dot.green {
    background: #f29b27;
}

.dot.red {
    background: #aaa;
}

/* ================= FORMS ================= */

.form-group {
    margin-bottom: 17px;
}

.form-group label {
    display: block;
    font-weight: bold;
    margin-bottom: 7px;
}

input,
select,
textarea {
    width: 100%;
    padding: 13px;
    border-radius: 11px;
    border: 1px solid #d6c5b7;
    background: white;
    font-family: inherit;
    font-size: 14px;
}

textarea {
    min-height: 90px;
}

.choice-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.choice {
    background: white;
    border: 2px solid #eadbd0;
    border-radius: 14px;
    padding: 15px;
    text-align: center;
    cursor: pointer;
}

.choice.selected {
    border-color: #f29b27;
    background: #fff0cd;
}

/* ================= STATUS ================= */

.success {
    text-align: center;
    padding: 45px 20px;
}

.success-icon {
    font-size: 75px;
    margin-bottom: 20px;
}

.success h1 {
    font-size: 29px;
    margin-bottom: 10px;
}

.status {
    display: inline-block;
    padding: 7px 12px;
    border-radius: 20px;
    background: #fff0c9;
    font-size: 12px;
    font-weight: bold;
    margin-top: 12px;
}

/* ================= ADMIN ================= */

.admin-card {
    background: white;
    padding: 18px;
    border-radius: 17px;
    margin-bottom: 12px;
    box-shadow: 0 3px 10px rgba(59,36,23,.07);
}

.admin-card h3 {
    margin-bottom: 7px;
}

.admin-stat {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 20px;
}

.stat {
    background: #f29b27;
    border-radius: 15px;
    padding: 15px 8px;
    text-align: center;
}

.stat strong {
    display: block;
    font-size: 22px;
}

/* ================= BOTTOM NAV ================= */

.bottom-nav {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 480px;
    height: 70px;
    background: white;
    border-top: 1px solid #eadbd0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    z-index: 30;
}

.nav-button {
    background: white;
    color: #806b5d;
    font-size: 11px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
}

.nav-button.active {
    color: #e87920;
    font-weight: bold;
}

.nav-icon {
    font-size: 21px;
}

/* ================= BACK ================= */

.back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    font-weight: bold;
    margin-bottom: 18px;
    color: #4a2b1b;
}
</style>
</head>

<body>

<div class="app">

<header class="header">
    <div class="logo">
        CLUB<br><span>DE LOS PANCHOS</span>
    </div>

    <button class="cart-icon" onclick="showScreen('cart')">
        🛒
        <span class="cart-count" id="cartCount">0</span>
    </button>
</header>


<!-- ================= INICIO ================= -->

<section id="home" class="screen active">

    <div class="hero">
        <div class="fake-hotdog">🌭</div>

        <h1>El Club<br>de los<br>Panchos</h1>

        <p>
            Panchos, eventos y un carrito que llega
            directo a tu fiesta.
        </p>

        <button class="main-button"
                onclick="showScreen('menu')">
            🌭 PEDIR AHORA
        </button>

        <button class="secondary-button"
                onclick="startEventReservation()">
            🚚 RESERVAR PARA UN EVENTO
        </button>
    </div>

    <div class="container">

        <h2 class="section-title">
            ¿Qué estás buscando?
        </h2>

        <div class="home-card"
             onclick="showScreen('menu')">

            <h3>🌭 Pedí para retirar</h3>

            <p>
                Elegí tu pancho, hacé tu pedido
                y pasá a retirarlo por el local.
            </p>
        </div>

        <div class="home-card"
             onclick="startEventReservation()">

            <h3>🚚 Llevamos el Club a tu fiesta</h3>

            <p>
                Reservá nuestro carrito para cumpleaños,
                fiestas y eventos.
            </p>
        </div>

        <div class="home-card">

            <h3>🌙 Nuestro local</h3>

            <p>
                Atención en el local durante la noche.
            </p>

            <p style="margin-top:8px;">
                💳 Efectivo · Transferencia
            </p>

        </div>

    </div>
</section>


<!-- ================= MENU ================= -->

<section id="menu" class="screen">

    <div class="container">

        <h2 class="section-title">🌭 El menú</h2>

        <div class="product-card">

            <div class="product-image">🌭</div>

            <h3>Pancho Normal</h3>

            <p class="product-description">
                El clásico del Club.
            </p>

            <div class="product-bottom">

                <span class="price">$ —</span>

                <button class="add-button"
                        onclick="addToCart('Pancho Normal')">
                    + AGREGAR
                </button>

            </div>

        </div>


        <div class="product-card">

            <div class="product-image">🌭</div>

            <h3>Pancho Extra Largo</h3>

            <p class="product-description">
                Más largo. Más pancho.
            </p>

            <div class="product-bottom">

                <span class="price">$ —</span>

                <button class="add-button"
                        onclick="addToCart('Pancho Extra Largo')">
                    + AGREGAR
                </button>

            </div>

        </div>


        <h2 class="section-title"
            style="margin-top:30px;">
            🍟 Combos
        </h2>


        <div class="product-card">

            <h3>Combo 1</h3>

            <p class="product-description">
                Próximamente se definirá qué incluye.
            </p>

            <div class="product-bottom">
                <span class="price">$ —</span>

                <button class="add-button"
                        onclick="addToCart('Combo 1')">
                    + AGREGAR
                </button>
            </div>

        </div>


        <div class="product-card">

            <h3>Combo 2</h3>

            <p class="product-description">
                Próximamente se definirá qué incluye.
            </p>

            <div class="product-bottom">
                <span class="price">$ —</span>

                <button class="add-button"
                        onclick="addToCart('Combo 2')">
                    + AGREGAR
                </button>
            </div>

        </div>


        <div class="product-card">

            <h3>Combo 3</h3>

            <p class="product-description">
                Próximamente se definirá qué incluye.
            </p>

            <div class="product-bottom">
                <span class="price">$ —</span>

                <button class="add-button"
                        onclick="addToCart('Combo 3')">
                    + AGREGAR
                </button>
            </div>

        </div>


        <div class="product-card">

            <h3>Combo 4</h3>

            <p class="product-description">
                Próximamente se definirá qué incluye.
            </p>

            <div class="product-bottom">
                <span class="price">$ —</span>

                <button class="add-button"
                        onclick="addToCart('Combo 4')">
                    + AGREGAR
                </button>
            </div>

        </div>

    </div>
</section>


<!-- ================= CART ================= -->

<section id="cart" class="screen">

    <div class="container">

        <h2 class="section-title">🛒 Tu pedido</h2>

        <div id="cartItems"></div>

        <div id="emptyCart"
             style="text-align:center;padding:50px 10px;">

            <div style="font-size:60px;">🌭</div>

            <h3>Tu carrito está vacío</h3>

            <p style="margin-top:8px;color:#806b5d;">
                Agregá algo rico del menú.
            </p>

            <button class="main-button"
                    onclick="showScreen('menu')">
                VER MENÚ
            </button>

        </div>

        <div id="cartTotal"
             class="total-box"
             style="display:none;">

            <div class="total-row">
                <span>Total</span>
                <strong>$ —</strong>
            </div>

            <button class="main-button"
                    style="background:#f29b27;color:#3b2417;"
                    onclick="showScreen('orderData')">
                CONTINUAR
            </button>

        </div>

    </div>
</section>


<!-- ================= DATOS PEDIDO ================= -->

<section id="orderData" class="screen">

    <div class="container">

        <button class="back"
                onclick="showScreen('cart')">
            ← Volver
        </button>

        <h2 class="section-title">
            Casi está 🌭
        </h2>

        <div class="form-group">
            <label>Nombre</label>
            <input id="orderName"
                   type="text"
                   placeholder="Tu nombre">
        </div>

        <div class="form-group">
            <label>Teléfono</label>
            <input id="orderPhone"
                   type="tel"
                   placeholder="Tu teléfono">
        </div>

        <div class="form-group">
            <label>Fecha de retiro</label>
            <input id="pickupDate"
                   type="date">
        </div>

        <div class="form-group">
            <label>Hora de retiro</label>
            <input id="pickupTime"
                   type="time">
        </div>

        <div class="form-group">
            <label>Forma de pago</label>

            <div class="choice-grid">

                <div class="choice"
                     onclick="selectChoice(this)">
                    💵<br>Efectivo
                </div>

                <div class="choice"
                     onclick="selectChoice(this)">
                    🏦<br>Transferencia
                </div>

            </div>
        </div>

        <button class="main-button"
                onclick="confirmOrder()">
            CONFIRMAR PEDIDO
        </button>

    </div>
</section>


<!-- ================= PEDIDO CONFIRMADO ================= -->

<section id="orderSuccess" class="screen">

    <div class="success">

        <div class="success-icon">🌭</div>

        <h1>¡Pedido confirmado!</h1>

        <p>
            Recibimos tu pedido correctamente.
        </p>

        <div class="status">
            Pedido #024 · Preparando
        </div>

        <button class="main-button"
                onclick="showScreen('home')">
            VOLVER AL INICIO
        </button>

    </div>

</section>


<!-- ================= EVENTOS ================= -->

<section id="events" class="screen">

    <div class="container">

        <button class="back"
                onclick="showScreen('home')">
            ← Volver
        </button>

        <h2 class="section-title">
            🚚 Llevamos el Club a tu fiesta
        </h2>

        <p style="line-height:1.5;color:#765f51;">
            Reservá nuestro carrito para tu cumpleaños,
            fiesta o evento.
        </p>

        <div class="hero"
             style="margin:20px 0 0;">

            <div class="fake-hotdog">🚚🌭</div>

            <h2>Vos ponés la fiesta.</h2>

            <h2>Nosotros llevamos los panchos.</h2>

        </div>

        <button class="main-button"
                onclick="showScreen('calendar')">
            ELEGIR FECHA
        </button>

    </div>
</section>


<!-- ================= CALENDARIO ================= -->

<section id="calendar" class="screen">

    <div class="container">

        <button class="back"
                onclick="showScreen('events')">
            ← Volver
        </button>

        <h2 class="section-title">
            📅 Elegí la fecha
        </h2>

        <div class="calendar">

            <div class="calendar-header">

                <button onclick="changeMonth(-1)">
                    ‹
                </button>

                <div class="calendar-title"
                     id="calendarTitle">
                </div>

                <button onclick="changeMonth(1)">
                    ›
                </button>

            </div>

            <div class="weekdays">
                <div>L</div>
                <div>M</div>
                <div>M</div>
                <div>J</div>
                <div>V</div>
                <div>S</div>
                <div>D</div>
            </div>

            <div class="days"
                 id="calendarDays">
            </div>

            <div class="legend">

                <span>
                    <span class="dot green"></span>
                    Disponible
                </span>

                <span>
                    <span class="dot red"></span>
                    Ocupado
                </span>

            </div>

        </div>

        <div id="selectedDateBox"
             style="margin-top:18px;display:none;">

            <div class="home-card">

                <h3>Fecha seleccionada</h3>

                <p id="selectedDateText"></p>

            </div>

            <button class="main-button"
                    onclick="showScreen('eventData')">
                CONTINUAR
            </button>

        </div>

    </div>
</section>


<!-- ================= DATOS EVENTO ================= -->

<section id="eventData" class="screen">

    <div class="container">

        <button class="back"
                onclick="showScreen('calendar')">
            ← Volver
        </button>

        <h2 class="section-title">
            🎉 Tu evento
        </h2>

        <div class="form-group">

            <label>Tipo de evento</label>

            <div class="choice-grid">

                <div class="choice"
                     onclick="selectEvent(this)">
                    🎂<br>Cumpleaños
                </div>

                <div class="choice"
                     onclick="selectEvent(this)">
                    💍<br>Casamiento
                </div>

                <div class="choice"
                     onclick="selectEvent(this)">
                    🎓<br>Fiesta
                </div>

                <div class="choice"
                     onclick="selectEvent(this)">
                    🏢<br>Empresarial
                </div>

            </div>

        </div>


        <div class="form-group">

            <label>Cantidad de personas</label>

            <input id="eventPeople"
                   type="number"
                   min="1"
                   placeholder="Ej: 40">

        </div>


        <div class="form-group">

            <label>Hora del evento</label>

            <input id="eventTime"
                   type="time">

            <small style="display:block;margin-top:6px;color:#806b5d;">
                Eventos disponibles durante todo el día.
            </small>

        </div>


        <div class="form-group">

            <label>Lugar del evento</label>

            <input id="eventPlace"
                   type="text"
                   placeholder="Ej: Salón, casa, quinta...">

        </div>


        <div class="form-group">

            <label>Dirección</label>

            <input id="eventAddress"
                   type="text"
                   placeholder="Dirección del evento">

        </div>


        <button class="main-button"
                onclick="showScreen('combos')">
            ELEGIR COMBO
        </button>

    </div>
</section>


<!-- ================= COMBOS ================= -->

<section id="combos" class="screen">

    <div class="container">

        <button class="back"
                onclick="showScreen('eventData')">
            ← Volver
        </button>

        <h2 class="section-title">
            🌭 Elegí tu combo
        </h2>

        <div id="comboList">

            <div class="product-card"
                 onclick="selectCombo(1)">

                <h3>Combo 1</h3>

                <p class="product-description">
                    Contenido a definir.
                </p>

                <div class="product-bottom">
                    <span class="price">$ —</span>
                    <button class="add-button">
                        ELEGIR
                    </button>
                </div>

            </div>


            <div class="product-card"
                 onclick="selectCombo(2)">

                <h3>Combo 2</h3>

                <p class="product-description">
                    Contenido a definir.
                </p>

                <div class="product-bottom">
                    <span class="price">$ —</span>
                    <button class="add-button">
                        ELEGIR
                    </button>
                </div>

            </div>


            <div class="product-card"
                 onclick="selectCombo(3)">

                <h3>Combo 3</h3>

                <p class="product-description">
                    Contenido a definir.
                </p>

                <div class="product-bottom">
                    <span class="price">$ —</span>
                    <button class="add-button">
                        ELEGIR
                    </button>
                </div>

            </div>


            <div class="product-card"
                 onclick="selectCombo(4)">

                <h3>Combo 4</h3>

                <p class="product-description">
                    Contenido a definir.
                </p>

                <div class="product-bottom">
                    <span class="price">$ —</span>
                    <button class="add-button">
                        ELEGIR
                    </button>
                </div>

            </div>

        </div>

    </div>
</section>


<!-- ================= RESERVA ================= -->

<section id="reservation" class="screen">

    <div class="success">

        <div class="success-icon">🚚🌭</div>

