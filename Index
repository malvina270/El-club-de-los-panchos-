<script>

/* ================= VARIABLES ================= */

let cart = [];

let currentMonth = new Date().getMonth();
let currentYear = new Date().getFullYear();

let selectedDate = null;
let selectedCombo = null;


/*
    FECHAS OCUPADAS

    Acá ustedes podrán agregar las fechas
    que ya tengan reservadas.

    Formato:
    "2026-10-20"
*/

let occupiedDates = [
    "2026-10-20"
];


/* ================= NAVEGACIÓN ================= */

function showScreen(id) {

    document.querySelectorAll(".screen")
        .forEach(screen => {
            screen.classList.remove("active");
        });

    const screen = document.getElementById(id);

    if (screen) {
        screen.classList.add("active");
    }

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}


/* ================= CARRITO ================= */

function addToCart(product) {

    const existing = cart.find(
        item => item.name === product
    );

    if (existing) {
        existing.quantity++;
    } else {
        cart.push({
            name: product,
            quantity: 1
        });
    }

    updateCart();

    alert(product + " agregado al carrito 🌭");
}


function updateCart() {

    const count = cart.reduce(
        (total, item) => total + item.quantity,
        0
    );

    document.getElementById("cartCount")
        .textContent = count;

    renderCart();
}


function renderCart() {

    const container =
        document.getElementById("cartItems");

    const empty =
        document.getElementById("emptyCart");

    const total =
        document.getElementById("cartTotal");

    if (cart.length === 0) {

        container.innerHTML = "";

        empty.style.display = "block";
        total.style.display = "none";

        return;
    }

    empty.style.display = "none";
    total.style.display = "block";

    container.innerHTML = cart.map(
        (item, index) => `

        <div class="cart-item">

            <div>
                <strong>${item.name}</strong>

                <p style="
                    color:#806b5d;
                    font-size:12px;
                    margin-top:4px;
                ">
                    Precio: $ —
                </p>
            </div>

            <div class="quantity">

                <button onclick="changeQuantity(${index}, -1)">
                    −
                </button>

                <strong>
                    ${item.quantity}
                </strong>

                <button onclick="changeQuantity(${index}, 1)">
                    +
                </button>

            </div>

        </div>
    `
    ).join("");
}


function changeQuantity(index, amount) {

    cart[index].quantity += amount;

    if (cart[index].quantity <= 0) {
        cart.splice(index, 1);
    }

    updateCart();
}


/* ================= PEDIDO ================= */

function confirmOrder() {

    const name =
        document.getElementById("orderName").value;

    const date =
        document.getElementById("pickupDate").value;

    const time =
        document.getElementById("pickupTime").value;

    if (!name || !date || !time) {

        alert(
            "Completá tu nombre, fecha y hora."
        );

        return;
    }

    showScreen("orderSuccess");
}


/* ================= CALENDARIO ================= */

function renderCalendar() {

    const title =
        document.getElementById("calendarTitle");

    const daysContainer =
        document.getElementById("calendarDays");

    const monthNames = [
        "Enero",
        "Febrero",
        "Marzo",
        "Abril",
        "Mayo",
        "Junio",
        "Julio",
        "Agosto",
        "Septiembre",
        "Octubre",
        "Noviembre",
        "Diciembre"
    ];

    title.textContent =
        monthNames[currentMonth]
        + " "
        + currentYear;


    const firstDay =
        new Date(
            currentYear,
            currentMonth,
            1
        ).getDay();


    const daysInMonth =
        new Date(
            currentYear,
            currentMonth + 1,
            0
        ).getDate();


    /*
        JavaScript empieza la semana
        en domingo. Lo convertimos para
        que empiece en lunes.
    */

    let startingDay = firstDay - 1;

    if (startingDay < 0) {
        startingDay = 6;
    }


    let html = "";

    for (let i = 0; i < startingDay; i++) {
        html += "<div></div>";
    }


    for (let day = 1; day <= daysInMonth; day++) {

        const month =
            String(currentMonth + 1).padStart(2, "0");

        const dayFormatted =
            String(day).padStart(2, "0");

        const dateString =
            `${currentYear}-${month}-${dayFormatted}`;


        const occupied =
            occupiedDates.includes(dateString);


        if (occupied) {

            html += `
                <div class="day occupied">
                    ${day}
                </div>
            `;

        } else {

            html += `
                <div
                    class="day available"
                    onclick="selectDate('${dateString}')"
                >
                    ${day}
                </div>
            `;
        }
    }


    daysContainer.innerHTML = html;
}


function changeMonth(amount) {

    currentMonth += amount;

    if (currentMonth < 0) {

        currentMonth = 11;
        currentYear--;

    }

    if (currentMonth > 11) {

        currentMonth = 0;
        currentYear++;

    }

    renderCalendar();
}


function selectDate(date) {

    selectedDate = date;

    const box =
        document.getElementById(
            "selectedDateBox"
        );

    const text =
        document.getElementById(
            "selectedDateText"
        );


    const dateObject =
        new Date(date + "T12:00:00");


    text.textContent =
        dateObject.toLocaleDateString(
            "es-UY",
            {
                weekday: "long",
                day: "numeric",
                month: "long",
                year: "numeric"
            }
        );


    box.style.display = "block";
}


/* ================= EVENTOS ================= */

function startEventReservation() {

    showScreen("events");

}


function selectEvent(element) {

    document
        .querySelectorAll("#eventData .choice")
        .forEach(choice => {
            choice.classList.remove("selected");
        });

    element.classList.add("selected");
}


function selectChoice(element) {

    element.parentElement
        .querySelectorAll(".choice")
        .forEach(choice => {
            choice.classList.remove("selected");
        });

    element.classList.add("selected");
}


function selectCombo(number) {

    selectedCombo = number;

    const people =
        document.getElementById(
            "eventPeople"
        ).value || "—";


    document.getElementById(
        "reservationSummary"
    ).innerHTML = `

        📅 <strong>${formatDate(selectedDate)}</strong><br><br>

        👥 <strong>${people}</strong> personas<br><br>

        🌭 <strong>Combo ${number}</strong><br><br>

        💰 Total: <strong>$ —</strong><br><br>

        🟡 Pendiente de confirmación

    `;


    showScreen("reservation");
}


function formatDate(date) {

    if (!date) return "No seleccionada";

    const object =
        new Date(date + "T12:00:00");

    return object.toLocaleDateString(
        "es-UY",
        {
            day: "numeric",
            month: "long",
            year: "numeric"
        }
    );
}


/* ================= INICIALIZAR ================= */

renderCalendar();
updateCart();

</script>

